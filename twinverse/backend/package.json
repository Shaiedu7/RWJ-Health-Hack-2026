{
  "name": "twinverse-patients-step1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --import tsx --test test/*.test.ts",
    "synth": "cdk synth --strict --output ../../work/patients-cdk.out",
    "preview:wyatt": "node --import tsx scripts/preview-wyatt.ts",
    "import:wyatt": "node --import tsx scripts/import-wyatt.ts",
    "load:patient": "node --import tsx scripts/load-patient.ts",
    "serve:student": "ENABLE_STUDENT_DEVELOPMENT_PREVIEW=true node --import tsx scripts/student-preview-server.ts",
    "synth:student-auth": "cdk synth --app \"node --import tsx bin/student-auth.ts\" --strict --output review/student-auth"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1149.0",
    "@aws-sdk/client-dynamodb": "3.1149.0",
    "@aws-sdk/client-sts": "3.1149.0",
    "@aws-sdk/credential-providers": "3.1149.0",
    "@aws-sdk/lib-dynamodb": "3.1149.0",
    "adm-zip": "0.6.1",
    "aws-cdk-lib": "^2.273.0",
    "aws-jwt-verify": "^5.2.1",
    "cdk-nag": "3.0.2",
    "constructs": "^10.4.0",
    "csv-parse": "7.0.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "aws-cdk": "2.1145.0",
    "eslint": "^9.0.0",
    "eslint-plugin-awscdk": "4.4.3",
    "prettier": "^3.0.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
