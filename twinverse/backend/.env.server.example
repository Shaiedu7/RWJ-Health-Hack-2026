# SERVER ONLY. Do not copy these names into Vite/browser configuration.
AWS_PROFILE=twinverse-event
AWS_REGION=us-west-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_LOGIN_DOMAIN=
# The real key is entered in AWS Secrets Manager, not in this file.
# Resolve at runtime through asm-exec when launching the future voice backend.
ELEVENLABS_API_KEY={{resolve:secretsmanager:twinverse/event/elevenlabs:SecretString:apiKey}}
ELEVENLABS_VOICE_ID=
ENABLE_STUDENT_DEVELOPMENT_PREVIEW=true

ENABLE_FACULTY_DEVELOPMENT=true
# Set true only after deploying the reviewed private document storage stack.
ENABLE_PATIENT_FILES=false
