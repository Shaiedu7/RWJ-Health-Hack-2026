# Copy this section to your personal ~/.aws/credentials (Windows: %USERPROFILE%\.aws\credentials).
# Replace placeholders locally with the three matching temporary event credentials.
# Do not commit the filled-in file. Refresh all three values when the session expires.
[twinverse-event]
aws_access_key_id = REPLACE_WITH_EVENT_ACCESS_KEY_ID
aws_secret_access_key = REPLACE_WITH_EVENT_SECRET_ACCESS_KEY
aws_session_token = REPLACE_WITH_EVENT_SESSION_TOKEN
